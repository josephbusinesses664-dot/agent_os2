# Autonomous Company Benchmark — ChurchApp (flagship)
# Goal: "Research, design, build, test, secure, deploy, and document a complete ChurchApp."
# One stage per line, mapped to the zero_to_hundred workflow and scored per-stage
# with evidence markers (artifact + keywords). The benchmark runner measures
# autonomy, evidence quality and tool usage stage by stage.
{"title": "ChurchApp market research", "description": "Research the church management software market. Use web.search to gather evidence on existing church management platforms (membership, giving, events, communication). Write a market research artifact covering competitors, user segments and pricing. Decision: recommend a target segment and positioning for ChurchApp.", "agent": "market-researcher", "required_artifacts": 1, "expected_markers": ["church", "market", "competitor", "segment"]}
{"title": "ChurchApp requirements definition", "description": "Produce a product requirements document for ChurchApp: core features (membership directory, giving/donations, event calendar, volunteer scheduling, announcements), user stories and success criteria. Decision: define the MVP scope with acceptance criteria.", "agent": "product-manager", "required_artifacts": 1, "expected_markers": ["membership", "giving", "event", "volunteer", "MVP"]}
{"title": "ChurchApp architecture design", "description": "Design the ChurchApp system architecture: frontend framework, backend API, database schema for members/giving/events, auth, and deployment topology. Write an architecture artifact with a data model and component diagram description. Decision: choose the stack and justify it.", "agent": "software-architect", "required_artifacts": 1, "expected_markers": ["architecture", "database", "auth", "API"]}
{"title": "ChurchApp backend data model", "description": "Implement the ChurchApp backend data model: define tables for members, donations, events, volunteers and announcements with relationships and indexes. Use repo.tree to explore the workspace and filesystem.write to create a schema.sql artifact. Decision: adopt the schema.", "agent": "database-engineer", "required_artifacts": 1, "expected_markers": ["members", "donations", "events", "CREATE TABLE"]}
{"title": "ChurchApp frontend shell", "description": "Create the ChurchApp frontend shell: a responsive dashboard layout with navigation for directory, giving, events and announcements. Write an index.html artifact with the app shell and wireframe sections. Decision: adopt the shell for the build phase.", "agent": "ui-designer", "required_artifacts": 1, "expected_markers": ["nav", "dashboard", "giving", "events"]}
{"title": "ChurchApp test plan", "description": "Write a comprehensive test plan for ChurchApp covering unit, integration and end-to-end tests for membership, giving, events and auth flows, including security test cases (injection, authz). Decision: approve the test plan.", "agent": "test-engineer", "required_artifacts": 1, "expected_markers": ["unit", "integration", "e2e", "auth", "security"]}
{"title": "ChurchApp security review", "description": "Perform a security review of the ChurchApp design: threat model for donations/payment data, member PII, authentication and authorization. Use repo.search to scan the workspace for secrets and vulnerabilities. Write a security report with findings and severity. Decision: identify blockers, if any.", "agent": "security-reviewer", "required_artifacts": 1, "expected_markers": ["threat", "auth", "severity", "finding"]}
{"title": "ChurchApp deployment plan", "description": "Produce a deployment and release plan for ChurchApp: staging environment, deployment steps, rollback strategy, monitoring and incident response. Decision: approve the plan for the release phase.", "agent": "deployment-agent", "required_artifacts": 1, "expected_markers": ["staging", "deploy", "rollback", "monitor"]}
{"title": "ChurchApp documentation", "description": "Write the ChurchApp user and developer documentation: getting started, architecture overview, API usage and operations runbook. Decision: publish the docs as the project's reference.", "agent": "documentation-agent", "required_artifacts": 1, "expected_markers": ["getting started", "API", "runbook", "install"]}